          "showLegend": true
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "targets": [
        {
          "expr": "sum by (request_type) (rate(telegram_requests_total{application=~\"$app_type\"}[1m]))",
          "legendFormat": "{{request_type}}",
          "refId": "A"
        }
      ],
      "title": "User Messages Per Second",
      "type": "timeseries"
