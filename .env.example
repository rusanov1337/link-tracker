# Copy to .env for local development. Never commit real credentials.
# Replace this placeholder with a token obtained from @BotFather.
TELEGRAM_TOKEN="<YOUR_TELEGRAM_BOT_TOKEN>"

# Public demonstration passwords for a local-only stack.
# Existing PostgreSQL/Grafana volumes retain their previously configured passwords.
SCRAPPER_DB_URL=jdbc:postgresql://localhost:5432/link_tracker
SCRAPPER_DB_USERNAME=postgres
SCRAPPER_DB_PASSWORD=link-tracker-local-postgres
SCRAPPER_DB_ACCESS_TYPE=SQL
GRAFANA_ADMIN_PASSWORD=link-tracker-local-grafana

# Applications run on the host; infrastructure runs in Docker Compose.
SCRAPPER_BASE_URL=http://localhost:8081
BOT_BASE_URL=http://localhost:8080
BOT_TRANSPORT=kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:19092,localhost:29092,localhost:39092
KAFKA_SCHEMA_REGISTRY_URL=http://localhost:8085
AI_AGENT_ENABLED=true
AI_AGENT_RAW_UPDATES_TOPIC=link.raw-updates
AI_AGENT_PROCESSED_UPDATES_TOPIC=link.processed-updates
VALKEY_HOST=localhost
VALKEY_PORT=6379
VALKEY_CLUSTER_ENABLED=true
VALKEY_CLUSTER_NODES=localhost:6379,localhost:6380,localhost:6381

# Optional API credentials: leave empty until needed.
GITHUB_TOKEN=
STACKOVERFLOW_KEY=
STACKOVERFLOW_ACCESS_TOKEN=
